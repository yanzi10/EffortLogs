<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#211F26"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_period_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Effort Log"
        android:textColor="#D0BCFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:text="Start your day with purpose!"
        android:textColor="#E6E1E5"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_quick_log_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#4F378B"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Quick Log"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>

